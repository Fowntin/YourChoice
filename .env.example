# ========================================
# Server & Hosting Environment
# ========================================
PORT=3000
NODE_ENV=production

# ========================================
# Cross-Origin Resource Sharing (CORS)
# ========================================
# Comma-separated list of allowed origins for Render backend.
# Note: https://*.github.io and local development origins are automatically authorized.
# Add your custom domains or specific GitHub Pages URLs here:
ALLOWED_ORIGINS=https://<your-github-username>.github.io

# ========================================
# Database Connection (MongoDB Atlas)
# ========================================
# Secure connection string from MongoDB Atlas dashboard.
# Configure this in Render Environment Variables (do NOT commit secrets to GitHub).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_DB_NAME=yourchoice

# ========================================
# Administrator Authentication & Security
# ========================================
# Set these in your Render Environment Variables to provision your initial admin.
# If omitted, auto-seeding is disabled to protect database security, and admins
# can be created using the CLI tool: 'npm run create-admin'
ADMIN_USERNAME=admin_manager
ADMIN_INITIAL_PASSWORD=ReplaceWithAStrongSecretPassword2026!

# Cryptographically strong secret key used to sign and verify JWT tokens (min 32 characters).
# Required in production. In development, a random ephemeral secret is generated at startup.
JWT_SECRET=replace_with_a_cryptographically_secure_random_key_min_32_characters

# Application frontend URL for password reset links (e.g. your GitHub Pages URL)
APP_URL=https://<your-github-username>.github.io/YourChoice

# ========================================
# Optional SMTP Email Configuration (Nodemailer)
# ========================================
# If unset, password reset links log to server console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
FROM_EMAIL="YourChoice Support" <no-reply@yourchoice.com>