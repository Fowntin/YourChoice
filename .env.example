PORT=3000
# MongoDB connection URI: specify database name before '?' (e.g., ...mongodb.net/yourchoice?appName=Cluster0)
MONGODB_URI=mongodb+srv://Fowntin:<db_password>@cluster0.b5vyopk.mongodb.net/yourchoice?appName=Cluster0
# Optional override for target database name (defaults to 'yourchoice')
MONGODB_DB_NAME=yourchoice
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=ChangeMeStrongPassword123!
